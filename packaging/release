#!/bin/bash
# Make a ret release.
#
# Put your keystore properties into ~/.gradle/gradle.properties
# (check app/build.gradle.kts)

set -e # fail on error
cd "$(dirname "$0")/.." # the paths of the project are relative to its root
GRADLE=${GRADLE:-./gradlew} # set value ./gradlew if not set
DIST=dist
TARGET_DIR_RUST_LINUX=ret-linux64
TARGET_DIR_RUST_WIN=ret-win64

version=$(git describe --tags --always)
TARGET_RUST_LINUX="$TARGET_DIR_RUST_LINUX-$version".zip
TARGET_RUST_WIN="$TARGET_DIR_RUST_WIN-$version".zip

"$GRADLE" checkAll releaseAll releaseWindows

rm -rf "$DIST"

for dir in "$TARGET_DIR_RUST_LINUX" "$TARGET_DIR_RUST_WIN"
do
    mkdir -p "$DIST/$dir"
    cp app/build/outputs/apk/release/ret-release.apk "$DIST/$dir"/ret.apk
done

for binary in ret ret-ui
do
    cp target/release/$binary "$DIST/$TARGET_DIR_RUST_LINUX"/
    strip "$DIST/$TARGET_DIR_RUST_LINUX"/$binary  # remove symbols for smaller binary
done
cp target/x86_64-pc-windows-gnu/release/ret.exe \
   target/x86_64-pc-windows-gnu/release/ret-ui.exe \
   packaging/windows/ret-run.cmd \
   "$DIST/$TARGET_DIR_RUST_WIN"/

cd "$DIST"
zip -r "$TARGET_RUST_LINUX" "$TARGET_DIR_RUST_LINUX"
zip -r "$TARGET_RUST_WIN" "$TARGET_DIR_RUST_WIN"
sha256sum "$TARGET_RUST_LINUX" "$TARGET_RUST_WIN" > SHA256SUMS.txt
