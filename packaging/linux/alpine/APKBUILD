# Maintainer: HoppouDev <me@hoppou.dev>
pkgname=ret
pkgver=0.4.0
pkgrel=0
pkgdesc="Reverse tethering for Android over adb"
url="https://github.com/HoppouDev/ret"
arch="x86_64 aarch64"
license="Apache-2.0"
depends="android-tools libx11 libxcursor libxi libxkbcommon
	libxkbcommon-x11 wayland-libs-client wayland-libs-cursor wayland-libs-egl
	mesa-egl mesa-gl hicolor-icon-theme"
makedepends="cargo"
source="$pkgname-$pkgver.tar.gz::https://github.com/HoppouDev/ret/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz
	ret.apk::https://github.com/HoppouDev/ret/releases/download/v$pkgver/ret-v$pkgver.apk"
sha512sums="
8a63f1977dd73c10a93187eeb40764ce830b1a0aa0f88fff82e0a14f00665f91d7409c99d9e9b8886ed0706e3a58c250911d38e97af361cce772e2827637a340  ret-0.3.0.tar.gz
2dd6fbba77c107874cb2eacdb6b9bc3a733959edec9aa250544992e2bb9a6f7df1cd5982bab1fd9552d0940eed903fc8dd0f9ff43e55f2109836e192f953c48c  ret.apk
"

prepare() {
	default_prepare
	CARGO_HOME="$srcdir"/cargo-home cargo fetch --locked
}

build() {
	CARGO_HOME="$srcdir"/cargo-home cargo build --release --frozen
}

check() {
	CARGO_HOME="$srcdir"/cargo-home cargo test --frozen
}

package() {
	install -Dm755 target/release/ret "$pkgdir"/usr/bin/ret
	install -Dm755 target/release/ret-ui "$pkgdir"/usr/bin/ret-ui
	install -Dm644 "$srcdir"/ret.apk "$pkgdir"/usr/share/ret/ret.apk
	install -Dm644 packaging/linux/ret.desktop "$pkgdir"/usr/share/applications/ret.desktop
	install -Dm644 assets/ret.png "$pkgdir"/usr/share/icons/hicolor/256x256/apps/ret.png
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/ret/LICENSE
}
