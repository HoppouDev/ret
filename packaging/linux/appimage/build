#!/bin/bash
# Build dist/ret-<version>-x86_64.AppImage
#
# The binaries are built in a container with an old glibc, so the image also runs on
# distributions which ret does not package for. The Android application comes from the
# release of the same version, or from the locally built signed application when there is
# one.
set -e
cd "$(dirname "$0")/../../.."
version=$(grep -m1 '^version = ' Cargo.toml | cut -d'"' -f2)
mkdir -p dist

docker run --rm \
  -e VERSION="$version" -e HOST_USER="$(id -u):$(id -g)" \
  -v "$PWD":/work -w /work rust:1-bullseye bash -ec '
  apt-get update -qq && apt-get install -yqq unzip
  curl -sL -o appimagetool.AppImage https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage
  chmod +x appimagetool.AppImage
  cargo build --release --locked --target-dir target-appimage
  rm -rf AppDir
  mkdir -p AppDir/usr/bin AppDir/usr/share/ret AppDir/usr/share/applications AppDir/usr/share/icons/hicolor/256x256/apps
  cp target-appimage/release/ret target-appimage/release/ret-ui AppDir/usr/bin/
  cp packaging/linux/ret.desktop AppDir/usr/share/applications/
  cp assets/ret.png AppDir/usr/share/icons/hicolor/256x256/apps/ret.png
  cp packaging/linux/appimage/AppRun AppDir/AppRun
  cp packaging/linux/ret.desktop AppDir/usr/share/applications/
  cp packaging/linux/ret.desktop AppDir/
  cp assets/ret.png AppDir/ret.png
  if [ -f app/build/outputs/apk/release/ret-release.apk ]; then
    cp app/build/outputs/apk/release/ret-release.apk AppDir/usr/share/ret/ret.apk
  else
    curl -sL -o /tmp/ret.zip "https://github.com/HoppouDev/ret/releases/download/v$VERSION/ret-linux64-v$VERSION.zip"
    unzip -o -j /tmp/ret.zip "ret-linux64/ret.apk" -d AppDir/usr/share/ret/
  fi
  ./appimagetool.AppImage --appimage-extract-and-run AppDir "dist/ret-$VERSION-x86_64.AppImage"
  chown -R "$HOST_USER" target-appimage AppDir dist appimagetool.AppImage
'
