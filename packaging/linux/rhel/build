#!/bin/bash
# Build dist/ret-<version>-1.el9.x86_64.rpm
#
# The binaries are built in a container with an old glibc, so the package also runs on
# Red Hat Enterprise Linux and its clones. The Android application comes from the release
# of the same version, or from the locally built signed application when there is one.
set -e
cd "$(dirname "$0")/../../.."
version=$(grep -m1 '^version = ' Cargo.toml | cut -d'"' -f2)
mkdir -p dist

docker run --rm \
  -e VERSION="$version" -e HOST_USER="$(id -u):$(id -g)" \
  -v "$PWD":/work -w /work rust:1-bullseye bash -ec '
  apt-get update -qq && apt-get install -yqq unzip
  cargo install --quiet cargo-generate-rpm
  cargo build --release --locked --target-dir target-rhel
  if [ -f app/build/outputs/apk/release/ret-release.apk ]; then
    cp app/build/outputs/apk/release/ret-release.apk target-rhel/release/ret.apk
  else
    curl -sL -o /tmp/ret.zip "https://github.com/HoppouDev/ret/releases/download/v$VERSION/ret-linux64-v$VERSION.zip"
    unzip -o -j /tmp/ret.zip "ret-linux64/ret.apk" -d target-rhel/release/
  fi
  cd crates/ret-cli
  cargo generate-rpm --set-metadata "assets = [
    { source = \"../../target-rhel/release/ret\", dest = \"/usr/bin/ret\", mode = \"755\" },
    { source = \"../../target-rhel/release/ret-ui\", dest = \"/usr/bin/ret-ui\", mode = \"755\" },
    { source = \"../../target-rhel/release/ret.apk\", dest = \"/usr/share/ret/ret.apk\", mode = \"644\" },
  ]" -o "../../dist/ret-$VERSION-1.el9.x86_64.rpm"
  chown -R "$HOST_USER" /work/target-rhel /work/dist
'
